{
  "name": "vitrina-3d",
  "version": "1.0.0",
  "private": true,
  "description": "Programa de escritorio para mostrar modelos 3D (3MF y STL) con sus colores y generar videos girando para clientes.",
  "type": "module",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "build:exe": "node scripts/build-web.mjs && node scripts/build-exe.mjs",
    "build": "npm run build:exe",
    "test": "node scripts/test-3mf.mjs"
  },
  "devDependencies": {
    "@fontsource/barlow": "5.0.13",
    "@fontsource/barlow-semi-condensed": "5.0.13",
    "@neutralinojs/neu": "11.7.2",
    "esbuild": "0.21.5",
    "fflate": "0.8.2",
    "mp4-muxer": "5.1.3",
    "pe-library": "1.0.1",
    "resedit": "2.0.3",
    "three": "0.160.0"
  }
}
